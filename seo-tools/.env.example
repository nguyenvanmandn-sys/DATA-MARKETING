# Sao chép file này thành ".env" (cùng thư mục) rồi điền giá trị thật.
# KHÔNG commit file .env có khóa thật lên git (đã được .gitignore bỏ qua).

# URL gốc của website WordPress
WP_SITE=https://danangmobile.com

# Tên đăng nhập WordPress của bạn
WP_USER=ten_dang_nhap

# Application Password lấy ở: wp-admin -> Users -> Profile -> Application Passwords
# Dán nguyên chuỗi (có thể có dấu cách), ví dụ: abcd EFGH 1234 wxyz 5678 90AB
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
